# --- Aplikacja ---
# Kanoniczny adres (linki w mailach). Lokalnie zostaw puste — użyty zostanie host żądania.
APP_URL=http://localhost:3000

# Losowy sekret sesji trenera. Produkcja: openssl rand -base64 32
# Minimum 16 znaków. Bez tej zmiennej lokalnie działa sekret deweloperski.
SESSION_SECRET=

# Allowlista e-maili trenera, rozdzielona przecinkami.
# Domyślnie (gdy puste): tomaszstefaniszyn9@gmail.com,czulosc.joga@gmail.com
TRAINER_EMAILS=tomaszstefaniszyn9@gmail.com,czulosc.joga@gmail.com

# --- Baza ---
# Puste lokalnie = wbudowany Postgres (PGlite) w katalogu ./data/pglite.
# Produkcja: connection string Supabase (session pooler, port 5432, sslmode=require).
# Nie używaj transaction poolera (port 6543).
DATABASE_URL=

# --- E-mail (Resend) ---
# Puste = tryb lokalny: treść zaproszenia i link trafiają do logu serwera oraz do okna zaproszenia.
RESEND_API_KEY=
# Nadawca zweryfikowany w Resend, np. Gym Rat <zaproszenia@twojadomena.pl>
EMAIL_FROM=

# --- Zdjęcia klientów (opcjonalnie Supabase Storage) ---
# Bez tych zmiennych zdjęcia są w Postgresie (kolumna bytea/text w tabeli clients).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Domyślnie "avatars", gdy ustawione są URL i klucz.
SUPABASE_BUCKET=avatars
